  <script>
    // CONFIGURAÇÕES
    // 1) Coloque seu endpoint server-side aqui (Vercel/Cloudflare/etc). Ex.: https://seusite.com/api/apply
    const BACKEND_ENDPOINT = ""; // <- obrigatório para salvar em planilha (deixe vazio se ainda não tiver)

    // 2) WhatsApp para redirecionamento após envio
    const WHATSAPP_URL = "https://api.whatsapp.com/send/?phone=5511983711418&text=Quero+falar+sobre+INTERVEN%C3%87%C3%83O.&type=phone_number&app_absent=0";

    const form = document.getElementById("appForm");
    const btn = document.getElementById("submitBtn");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form).entries());

      btn.disabled = true;
      btn.textContent = "Enviando...";

      try{
        if(!BACKEND_ENDPOINT){
          // Sem backend: não salva em lugar nenhum. Redireciona para WhatsApp com payload no texto (opcional).
          // Melhor: só redirecionar. Evita vazar dados sensíveis na URL.
          window.location.href = WHATSAPP_URL;
          return;
        }

        const res = await fetch(BACKEND_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        if(!res.ok) throw new Error("Falha no envio");

        // Sucesso -> WhatsApp
        window.location.href = WHATSAPP_URL;

      } catch(err){
        alert("Não foi possível enviar. Tente novamente em instantes.");
        btn.disabled = false;
        btn.textContent = "Enviar aplicação";
      }
    });
  </script>
